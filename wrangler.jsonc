{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cvanalyzer",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"ai":{
		"binding":"AI"
	},
	"durable_objects": {
        "bindings": [
            {
                "name": "DURABLE_OBJECTS",
                "class_name": "DURABLE_OBJECTS"
            }
        ]
    },
	"migrations": [
		{
			"tag":"v1",
			"new_classes": ["DURABLE_OBJECTS"]
		}
	]
}